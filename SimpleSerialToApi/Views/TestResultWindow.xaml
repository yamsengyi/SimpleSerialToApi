<Window x:Class="SimpleSerialToApi.Views.TestResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mapping Test Result" 
        Width="850" Height="500"
        MinWidth="600" MinHeight="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Mapping Test Result" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="TestInputInfo" FontSize="11" Foreground="#666" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Simple List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultsContainer">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8" Background="#FAFAFA">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 1: 시나리오 이름 / 통신방식 -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                    <Border Grid.Column="1" CornerRadius="3" Padding="6,1" Background="{Binding TypeColor}">
                                        <TextBlock Text="{Binding TypeText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>

                                <!-- Row 2: 실제 전달 데이터 / curl 명령어 -->
                                <Border Grid.Row="1" Background="{Binding DataBg}" BorderBrush="{Binding DataBorder}" BorderThickness="1" CornerRadius="3" Padding="8,5">
                                    <TextBlock Text="{Binding DataText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="닫기" IsCancel="True" Padding="15,8" MinWidth="80" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
